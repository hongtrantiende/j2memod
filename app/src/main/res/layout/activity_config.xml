<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/configRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/rootConfigNetwork"
            android:background="?attr/bg_config_card"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            app:elevation="2dp">
            <TextView
                android:id="@+id/tvConfigNetworkTitle"
                android:text="@string/ip_redirect"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/ConfigTitleTextStyle"/>
            <EditText
                android:id="@+id/tfProxyAddr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/ip_address"
                android:inputType="textNoSuggestions"
                app:layout_constraintEnd_toStartOf="@+id/tfProxyPort"
                app:layout_constraintHorizontal_weight="3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvConfigNetworkTitle"
                style="@style/EditTextStyle"/>
            <EditText
                android:id="@+id/tfProxyPort"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/port"
                android:inputType="number"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@+id/tfProxyAddr"
                app:layout_constraintTop_toBottomOf="@+id/tvConfigNetworkTitle"
                style="@style/EditTextStyle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/rootConfigScreen"
            android:background="?attr/bg_config_card"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp">
            <TextView
                android:id="@+id/tvConfigScreenTitle"
                android:text="@string/PREF_SCREEN_OPTIONS"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/ConfigTitleTextStyle"/>
            <ImageButton
                android:gravity="center"
                android:id="@+id/cmdScreenSizePresets"
                android:layout_width="@dimen/height_config_row"
                android:layout_height="0dp"
                android:src="@drawable/ic_list"
                android:contentDescription="@string/SIZE_PRESETS"
                app:layout_constraintBottom_toBottomOf="@+id/tfScreenWidth"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvConfigScreenTitle"
                app:tooltipText="@string/SIZE_PRESETS"
                style="@style/ImageButtonStyle"/>
            <EditText
                android:textSize="22sp"
                android:gravity="center"
                android:id="@+id/tfScreenWidth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/PREF_WIDTH"
                android:maxLines="1"
                android:inputType="numberSigned"
                app:layout_constraintEnd_toStartOf="@+id/cmdSwapSizes"
                app:layout_constraintStart_toEndOf="@+id/cmdScreenSizePresets"
                app:layout_constraintTop_toBottomOf="@+id/tvConfigScreenTitle"
                style="@style/EditTextStyle"/>
            <ImageButton
                android:gravity="center"
                android:id="@+id/cmdSwapSizes"
                android:layout_width="@dimen/height_config_row"
                android:layout_height="0dp"
                android:src="@drawable/ic_swap"
                android:contentDescription="@string/SWAP_SIZES"
                app:layout_constraintBottom_toBottomOf="@+id/tfScreenWidth"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvConfigScreenTitle"
                app:tooltipText="@string/SWAP_SIZES"
                style="@style/ImageButtonStyle"/>
            <EditText
                android:textSize="22sp"
                android:gravity="center"
                android:id="@+id/tfScreenHeight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/PREF_HEIGHT"
                android:maxLines="1"
                android:inputType="numberSigned"
                app:layout_constraintEnd_toStartOf="@+id/cmdAddToPreset"
                app:layout_constraintStart_toEndOf="@+id/cmdSwapSizes"
                app:layout_constraintTop_toBottomOf="@+id/tvConfigScreenTitle"
                style="@style/EditTextStyle"/>
            <ImageButton
                android:gravity="center"
                android:id="@+id/cmdAddToPreset"
                android:layout_width="@dimen/height_config_row"
                android:layout_height="0dp"
                android:src="@drawable/ic_add_preset"
                app:layout_constraintBottom_toBottomOf="@+id/tfScreenHeight"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvConfigScreenTitle"
                style="@style/ImageButtonStyle"/>
            <Button
                android:id="@+id/cmdScreenBack"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_margin="4dp"
                android:text="@string/PREF_BACKGROUND"
                app:layout_constraintBottom_toBottomOf="@+id/tfScreenBack"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tfScreenBack"/>
            <EditText
                android:gravity="center"
                android:id="@+id/tfScreenBack"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/PREF_COLOR_HINT"
                android:inputType="textNoSuggestions"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/cmdScreenBack"
                app:layout_constraintTop_toBottomOf="@+id/tfScreenHeight"
                style="@style/EditTextStyle"/>
            <TextView
                android:textSize="15sp"
                android:textColor="?attr/textColorSecondary"
                android:gravity="center_vertical"
                android:id="@+id/textView3"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/height_config_row"
                android:text="@string/PREF_SCALE_RATIO"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tfScreenBack"/>
            <SeekBar
                android:id="@+id/sbScaleRatio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:max="100"
                app:layout_constraintBottom_toBottomOf="@+id/tfScaleRatioValue"
                app:layout_constraintEnd_toStartOf="@+id/tfScaleRatioValue"
                app:layout_constraintStart_toEndOf="@+id/textView3"
                app:layout_constraintTop_toTopOf="@+id/tfScaleRatioValue"/>
            <EditText
                android:gravity="center"
                android:id="@+id/tfScaleRatioValue"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/height_config_row"
                android:hint="100"
                android:ems="2"
                android:inputType="number"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tfScreenBack"
                style="@style/EditTextStyle"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textSize="15sp"
                android:textColor="?attr/textColorSecondary"
                android:gravity="center_vertical"
                android:id="@+id/textView4"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/height_config_row"
                android:text="@string/PREF_ORIENTATION"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView3"/>
            <Spinner
                android:textSize="15sp"
                android:textColor="?attr/textColorSecondary"
                android:entries="@array/PREF_ORIENTATION_ENTRIES"
                android:id="@+id/spOrientation"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_config_row"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/textView4"
                app:layout_constraintTop_toBottomOf="@+id/tfScaleRatioValue"/>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/cxScaleToFit"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_config_row"
                android:checked="true"
                android:text="@string/PREF_SCALE_TO_FIT"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView4"
                style="@style/SwitchStyle"/>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/cxKeepAspectRatio"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_config_row"
                android:checked="true"
                android:text="@string/PREF_KEEP_ASPECT_RATIO"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cxScaleToFit"
                style="@style/SwitchStyle"/>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/cxFilter"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_config_row"
                android:checked="false"
                android:text="@string/PREF_FILTER"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cxKeepAspectRatio"
                style="@style/SwitchStyle"/>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/cxImmediate"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_config_row"
                android:checked="false"
                android:text="@string/PREF_IMMEDIATE"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cxFilter"
                style="@style/SwitchStyle"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textSize="15sp"
                android:textColor="?attr/textColorSecondary"
                android:gravity="center_vertical"
                android:id="@+id/tvGraphicsMode"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/height_config_row"
                android:checked="false"
                android:text="@string/pref_graphics_mode_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cxImmediate"/>
            <Spinner
                android:textSize="15sp"
                android:textColor="?attr/textColorSecondary"
                android:entries="@array/pref_graphics_mode_entries"
                android:id="@+id/spGraphicsMode"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_config_row"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tvGraphicsMode"
                app:layout_constraintTop_toBottomOf="@+id/cxImmediate"
                style="@style/SwitchStyle"/>
            <LinearLayout
                android:id="@+id/shaderContainer"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvGraphicsMode">
                <TextView
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textSize="15sp"
                    android:textColor="?attr/textColorSecondary"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/PREF_SHADER_FILTER"/>
                <Spinner
                    android:textSize="15sp"
                    android:textColor="?attr/textColorSecondary"
                    android:id="@+id/spShader"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>
                <ImageButton
                    android:id="@+id/btShaderTune"
                    android:visibility="gone"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_baseline_tune_24"
                    android:contentDescription="@string/shader_tuning"
                    style="@style/ImageButtonStyle"/>
            </LinearLayout>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/cxParallel"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_config_row"
                android:checked="false"
                android:text="@string/parallel_screen_redrawing"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/shaderContainer"
                style="@style/SwitchStyle"/>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/cxForceFullscreen"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_config_row"
                android:checked="false"
                android:text="@string/PREF_FORCE_FULLSCREEN"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cxParallel"
                style="@style/SwitchStyle"/>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/cxShowFps"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_config_row"
                android:checked="false"
                android:text="@string/PREF_SHOW_FPS"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cxForceFullscreen"
                style="@style/SwitchStyle"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textSize="15sp"
                android:textColor="?attr/textColorSecondary"
                android:gravity="center_vertical"
                android:id="@+id/cxLimitFps"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/height_config_row"
                android:layout_marginBottom="9dp"
                android:text="@string/PREF_LIMIT_FPS"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cxShowFps"/>
            <EditText
                android:gravity="center"
                android:id="@+id/tfFpsLimit"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_config_row"
                android:layout_marginBottom="9dp"
                android:hint="@string/unlimited"
                android:width="0dp"
                android:inputType="numberSigned"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/cxLimitFps"
                app:layout_constraintTop_toBottomOf="@+id/cxShowFps"
                style="@style/EditTextStyle"/>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/cxGrayscale"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_config_row"
                android:checked="false"
                android:text="@string/PREF_SCREEN_GRAYSCALE"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tfFpsLimit"
                style="@style/SwitchStyle"/>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/cxSleepTab"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_config_row"
                android:checked="false"
                android:text="@string/PREF_SLEEP_TAB"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cxGrayscale"
                style="@style/SwitchStyle"/>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/cxAutoSleep"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_config_row"
                android:checked="false"
                android:text="@string/PREF_AUTO_SLEEP"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cxSleepTab"
                style="@style/SwitchStyle"/>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/cxReduceGraphics"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_config_row"
                android:checked="false"
                android:text="@string/PREF_REDUCE_GRAPHICS"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cxAutoSleep"
                style="@style/SwitchStyle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/rootConfigFont"
            android:background="?attr/bg_config_card"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            app:elevation="2dp">
            <TextView
                android:id="@+id/tvConfigFontTitle"
                android:text="@string/PREF_FONT_OPTIONS"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/ConfigTitleTextStyle"/>
            <EditText
                android:gravity="center"
                android:id="@+id/tfFontSizeSmall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/PREF_FONT_SMALL"
                android:inputType="number"
                app:layout_constraintEnd_toStartOf="@+id/textView8"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvConfigFontTitle"
                style="@style/EditTextStyle"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:gravity="center"
                android:id="@+id/textView8"
                android:layout_width="20dp"
                android:layout_height="0dp"
                android:text="@string/_FONT_SEPARATOR"
                app:layout_constraintBottom_toBottomOf="@+id/tfFontSizeSmall"
                app:layout_constraintEnd_toStartOf="@+id/tfFontSizeMedium"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/tfFontSizeSmall"
                app:layout_constraintTop_toTopOf="@+id/tfFontSizeSmall"/>
            <EditText
                android:gravity="center"
                android:id="@+id/tfFontSizeMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/PREF_FONT_MEDIUM"
                android:inputType="number"
                app:layout_constraintEnd_toStartOf="@+id/textView9"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@+id/textView8"
                app:layout_constraintTop_toBottomOf="@+id/tvConfigFontTitle"
                style="@style/EditTextStyle"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:gravity="center"
                android:id="@+id/textView9"
                android:layout_width="20dp"
                android:layout_height="0dp"
                android:text="@string/_FONT_SEPARATOR"
                app:layout_constraintBottom_toBottomOf="@+id/tfFontSizeLarge"
                app:layout_constraintEnd_toStartOf="@+id/tfFontSizeLarge"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/tfFontSizeMedium"
                app:layout_constraintTop_toTopOf="@+id/tfFontSizeLarge"/>
            <EditText
                android:gravity="center"
                android:id="@+id/tfFontSizeLarge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/PREF_FONT_LARGE"
                android:inputType="number"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@+id/textView9"
                app:layout_constraintTop_toBottomOf="@+id/tvConfigFontTitle"
                style="@style/EditTextStyle"/>
            <Button
                android:gravity="center"
                android:id="@+id/cmdFontSizePresets"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_margin="4dp"
                android:text="@string/SIZE_PRESETS"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tfFontSizeMedium"/>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/cxFontSizeInSP"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_config_row"
                android:text="@string/PREF_FONT_SIZE_IN_SP"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cmdFontSizePresets"
                style="@style/SwitchStyle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/rootInputConfig"
            android:background="?attr/bg_config_card"
            android:paddingTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            app:elevation="2dp">
            <TextView
                android:id="@+id/tvConfigInputTitle"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:text="@string/pref_input_devices_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/ConfigTitleTextStyle"/>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/cxTouchInput"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_config_row"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:text="@string/PREF_TOUCH_INPUT"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvConfigInputTitle"
                app:layout_constraintWidth_min="wrap"
                style="@style/SwitchStyle"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textSize="15sp"
                android:textColor="?attr/textColorSecondary"
                android:gravity="center_vertical"
                android:id="@+id/textView6"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_config_row"
                android:layout_marginLeft="5dp"
                android:text="@string/PREF_LAYOUT"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toStartOf="@+id/barrierConfig"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cxTouchInput"
                app:layout_constraintWidth_min="wrap"/>
            <Spinner
                android:textSize="15sp"
                android:textColor="?attr/textColorSecondary"
                android:gravity="end"
                android:entries="@array/PREF_LAYOUT_ENTRIES"
                android:id="@+id/spLayout"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_config_row"
                android:layout_marginRight="5dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/barrierConfig"
                app:layout_constraintTop_toBottomOf="@+id/cxTouchInput"/>
            <Button
                android:id="@+id/cmdKeyMappings"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginLeft="9dp"
                android:layout_marginTop="4dp"
                android:layout_marginRight="9dp"
                android:layout_marginBottom="4dp"
                android:text="@string/pref_map_keys"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView6"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupVkConfig"
                android:background="?attr/bg_config_card"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                app:constraint_referenced_ids="cxVKForceOpacity,tvVkType,cxVKFeedback,tfVKBack,spVKType,tfVKSelFore,textView7,cmdVKSelFore,cmdVKFore,tfVKOutline,cmdVKBack,sbVKAlpha,cmdVKSelBack,tfVKHideDelay,textView13,spButtonsShape,tvOpacity,cmdVKOutline,textView12,tfVKFore,tfVKSelBack"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cmdKeyMappings"/>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/cxIsShowKeyboard"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_config_row"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="5dp"
