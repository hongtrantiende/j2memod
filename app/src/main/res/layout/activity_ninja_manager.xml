<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- ═══ HEADER ═══════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:elevation="2dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:visibility="gone"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_tool_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOOL Namod"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#1A1A2E" />

            <TextView
                android:id="@+id/tv_tool_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 nick · Đang tải..."
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ═══ FEATURE CARDS ════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:layout_marginTop="8dp"
        android:paddingBottom="4dp">

        <!-- Auto Nhóm -->
        <LinearLayout
            android:id="@+id/card_auto_nhom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto nh&#243;m t&#7921; &#273;&#7897;ng"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A2E"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PT nh&#243;m c&#7921;c nhanh cho ae"
                    android:textSize="12sp"
                    android:textColor="#888888"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#8250;"
                android:textSize="20sp"
                android:textColor="#AAAAAA"/>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="0.5dp"
              android:background="#EEEEEE" android:layout_marginHorizontal="14dp"/>

        <!-- Auto TATL -->
        <LinearLayout
            android:id="@+id/card_auto_tatl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto TATL t&#7921; &#273;&#7897;ng"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A2E"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="H&#7895; tr&#7907; g&#7843;n ingame t&#236;m boss nhanh"
                    android:textSize="12sp"
                    android:textColor="#888888"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#8250;"
                android:textSize="20sp"
                android:textColor="#AAAAAA"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ═══ NICK LIST ════════════════════════════════════════════════ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_nick_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"/>

    <!-- ═══ BOTTOM BAR ════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="4dp">

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <Button
                android:id="@+id/btn_add_nick"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="+ Th&#234;m nick"
                android:textSize="13sp"
                android:backgroundTint="#E8E8E8"
                android:textColor="#1A1A2E"
                style="?attr/materialButtonStyle"/>

            <Button
                android:id="@+id/btn_enable_all"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="B&#7853;t t&#7845;t c&#7843;"
                android:textSize="13sp"
                android:backgroundTint="#E8E8E8"
                android:textColor="#1A1A2E"
                style="?attr/materialButtonStyle"/>

            <Button
                android:id="@+id/btn_disable_all"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="T&#7855;t t&#7845;t c&#7843;"
                android:textSize="13sp"
                android:backgroundTint="#E8E8E8"
                android:textColor="#1A1A2E"
                style="?attr/materialButtonStyle"/>
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/btn_account"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="T&#224;i kho&#7843;n"
                android:textSize="13sp"
                android:backgroundTint="#E8E8E8"
                android:textColor="#1A1A2E"
                style="?attr/materialButtonStyle"/>

            <Button
                android:id="@+id/btn_console"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="Console"
                android:textSize="13sp"
                android:backgroundTint="#E8E8E8"
                android:textColor="#1A1A2E"
                style="?attr/materialButtonStyle"/>

            <Button
                android:id="@+id/btn_settings"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:text="C&#224;i &#273;&#7863;t"
                android:textSize="13sp"
                android:backgroundTint="#E8E8E8"
                android:textColor="#1A1A2E"
                style="?attr/materialButtonStyle"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
