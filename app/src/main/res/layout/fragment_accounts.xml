<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F1117">

    <!-- Banner trạng thái JAR -->
    <androidx.cardview.widget.CardView
        android:id="@+id/banner_jar_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardBackgroundColor="#1E2A1E"
        app:cardCornerRadius="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/banner_jar_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✅"
                android:textSize="18sp"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/banner_jar_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NinjaNamod.jar"
                    android:textColor="#A5D6A7"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/banner_jar_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đã cài đặt — sẵn sàng"
                    android:textColor="#66BB6A"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_run_all"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="▶ Tất Cả"
                android:textSize="12sp"
                app:backgroundTint="#00B8D4"
                app:cornerRadius="18dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Import từ file -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tv_account_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 tài khoản"
            android:textColor="#78909C"
            android:textSize="12sp"
            android:gravity="center_vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_import_accounts"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Import .txt"
            android:textSize="12sp"
            android:textColor="#00B8D4" />
    </LinearLayout>

    <!-- Danh sách TK -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_accounts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingBottom="80dp"
        android:clipToPadding="false"
        android:overScrollMode="never" />

</LinearLayout>
