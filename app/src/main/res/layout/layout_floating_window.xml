<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/window_root"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@drawable/bg_floating_window"
    android:orientation="vertical">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="36dp"
        android:background="@drawable/bg_floating_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingRight="4dp">

        <!-- Tab Menu button (triggers long-press * to show tab menu) -->
        <LinearLayout
            android:id="@+id/btn_tab_menu"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="?android:selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="6dp"
            android:paddingRight="8dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_tab_menu" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="TAB"
                android:textColor="#4CAF50"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Move handle area (drag to move window) -->
        <FrameLayout
            android:id="@+id/move_handle"
            android:layout_width="0dp"
            android:layout_height="fill_parent"
            android:layout_weight="1"
            android:focusable="true"
            android:focusableInTouchMode="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="J2ME • Kéo di chuyển"
                android:textColor="#78909C"
                android:textSize="11sp" />
        </FrameLayout>

        <!-- Hide Keyboard button -->
        <ImageView
            android:id="@+id/btn_hide_keyboard"
            android:layout_width="34dp"
            android:layout_height="fill_parent"
            android:background="?android:selectableItemBackground"
            android:padding="6dp"
            android:src="@drawable/ic_keyboard_hide"
            android:contentDescription="Ẩn bàn phím" />

        <!-- Maximize button (Full screen) -->
        <ImageView
            android:id="@+id/maximize_window"
            android:layout_width="34dp"
            android:layout_height="fill_parent"
            android:background="?android:selectableItemBackground"
            android:padding="7dp"
            android:src="@android:drawable/ic_menu_zoom" />

        <!-- Minimize button (back to floating bubble) -->
        <ImageView
            android:id="@+id/close_window"
            android:layout_width="34dp"
            android:layout_height="fill_parent"
            android:background="?android:selectableItemBackground"
            android:padding="7dp"
            android:src="@drawable/ic_minimize" />
    </LinearLayout>

    <!-- Game Screen & Overlay Container -->
    <FrameLayout
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#ff000000">

        <FrameLayout
            android:id="@+id/game_container"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:background="#ff000000" />

        <javax.microedition.lcdui.overlay.OverlayView
            android:id="@+id/vOverlay"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent" />

        <!-- Bottom-right resize corner handle -->
        <ImageView
            android:id="@+id/resize_handle"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="bottom|end"
            android:background="?android:selectableItemBackground"
            android:padding="4dp"
            android:src="@drawable/ic_resize_corner" />
    </FrameLayout>

    <!-- Bottom Command Bar for Non-Canvas Screens (TextBox, Form, List commands) -->
    <LinearLayout
        android:id="@+id/floating_command_bar"
        android:layout_width="fill_parent"
        android:layout_height="46dp"
        android:background="#212830"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="gone" />
</LinearLayout>