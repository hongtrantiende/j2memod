<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="0"
                android:startColor="#00B09B"
                android:endColor="#0288D1"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#80E0F7FA" />
            <padding
                android:left="8dp"
                android:top="3dp"
                android:right="10dp"
                android:bottom="3dp" />
        </shape>
    </item>
</ripple>
